# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_USER_ID=your_telegram_numeric_user_id

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/growth_agent

# ── LLM Keys (fallback chain: Groq → OpenRouter → Gemini) ─────────────────────
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
GEMINI_API_KEY=your_gemini_api_key

# ── Google Sheets OAuth ───────────────────────────────────────────────────────
# Path to the credentials.json downloaded from Google Cloud Console
# Scopes needed: https://www.googleapis.com/auth/spreadsheets
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json

# ── Schedule (cron format, all times are local server time) ───────────────────
# Morning mental exercise
CRON_MORNING=0 7 * * *
# Afternoon mental exercise
CRON_AFTERNOON=0 13 * * *
# Night mental exercise
CRON_NIGHT=0 21 * * *
# Evening habit check-in
CRON_HABIT_CHECKIN=0 20 * * *
# Nightly self-reflection (agent introspects on itself + the user)
CRON_SELF_REFLECTION=0 22 * * *

# ── Google Sheet IDs (set after running npm run setup) ────────────────────────
# These are auto-populated by scripts/setup.ts, or you can fill manually
SHEET_BUDGET_ID=
SHEET_WORKOUTS_ID=
SHEET_HABITS_ID=
